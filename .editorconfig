# EditorConfig helps maintain consistent coding styles
# across various editors and IDEs
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP files
[*.php]
indent_size = 4

# Blade templates
[*.blade.php]
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# HTML/CSS
[*.{html,css,scss,sass}]
indent_size = 2

# Package.json
[package.json]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 2

# SQL
[*.sql]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# Docker
[Dockerfile*]
indent_size = 2

[docker-compose*.yml]
indent_size = 2
